{
  "mcpServers": {
    "xh-tuvan": {
      "command": "<python-from-the-installed-0.9.0-environment>",
      "args": [
        "<installed-plugin-root>\\scripts\\xh_mcp_server.py"
      ],
      "env": {
        "XH_PROJECTS_ROOT": "<persistent-filesystem>\\02_Workspace\\projects",
        "XH_REPORT_LIBRARY": "<persistent-filesystem>\\04_Library\\references\\report-library",
        "PYTHONUTF8": "1",
        "XH_TUVAN_KNOWLEDGE_ROOT": "<persistent-local-non-synced-filesystem>/xh-tuvan"
      }
    }
  }
}
